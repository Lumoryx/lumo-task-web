{
  "name": "lumo-task-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && npx esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/bundle.cjs \"--external:node:*\"",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "start": "node dist/index.js",
    "test": "node --env-file src/test/.env.test --import tsx/esm --test src/test/api.test.ts",
    "test:coverage": "node --env-file src/test/.env.test --import tsx/esm --test --experimental-test-coverage src/test/api.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "^0.8.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.12.22",
    "jose": "^5.10.0",
    "nanoid": "^5.1.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3"
  }
}
